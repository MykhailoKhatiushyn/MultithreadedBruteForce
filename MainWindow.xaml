<Window x:Class="MultithreadedBruteForce.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="Multi-Threaded Brute Force Password Resetter" Height="680" Width="850"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Brute Force Password Recovery &amp; Benchmarking" 
                   FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Section 1: Target Password Setup -->
        <GroupBox Header="1. Target Password Creation" Grid.Row="1" Margin="0,0,0,10" Padding="10" FontWeight="Bold">
            <Grid FontWeight="Normal">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnGenerate" Content="Generate Target Password" Width="180" Height="30" 
                        Click="BtnGenerate_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>

                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock x:Name="TxtPlainPassword" Text="Target Plain Password: [Not Generated]" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTargetHash" Text="Target SHA-256 Hash: [None]" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Section 2: Execution Controls -->
        <GroupBox Header="2. Execution Configuration" Grid.Row="2" Margin="0,0,0,10" Padding="10" FontWeight="Bold">
            <StackPanel Orientation="Horizontal" FontWeight="Normal">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <RadioButton x:Name="RbMultiThread" Content="Multi-Threaded (CPU Cores - 1)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <RadioButton x:Name="RbSingleThread" Content="Single-Threaded" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <RadioButton x:Name="RbBenchmark" Content="Run Benchmark (Both)" VerticalAlignment="Center" Margin="0,0,25,0"/>

                <Button x:Name="BtnStart" Content="Start Attack" Width="110" Height="30" Click="BtnStart_Click" 
                        Background="#2980B9" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button x:Name="BtnStop" Content="Stop Attack" Width="110" Height="30" Click="BtnStop_Click" 
                        IsEnabled="False" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <!-- Section 3: Status & Progress Display -->
        <GroupBox Header="3. Live Progress &amp; Diagnostics" Grid.Row="3" Margin="0,0,0,10" Padding="10" FontWeight="Bold">
            <Grid FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar x:Name="ProgressBarAttack" Height="20" IsIndeterminate="False" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtElapsedTime" Text="Elapsed Time: 00:00.00" FontSize="13"/>
                    <TextBlock x:Name="TxtTotalAttempts" Grid.Column="1" Text="Total Attempts: 0" FontSize="13"/>
                    <TextBlock x:Name="TxtCoresUsed" Grid.Column="2" Text="Active Cores: -" FontSize="13"/>
                </Grid>

                <TextBlock x:Name="TxtResultPassword" Grid.Row="2" Text="Result: Waiting..." FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,5,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Section 4: Log Output -->
        <GroupBox Header="4. Performance Log &amp; Benchmark Output" Grid.Row="4" Padding="10" FontWeight="Bold">
            <TextBox x:Name="TxtLogOutput" FontFamily="Consolas" FontSize="12" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#DCDCDC"/>
        </GroupBox>
    </Grid>
</Window>